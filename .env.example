# 运行环境：development / staging / production
APP_ENV=development
# API 服务监听地址
API_ADDRESS=:8080
# API 允许的浏览器来源，逗号分隔；生产环境必须替换为实际玩家端和后台域名
API_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Worker 轮询任务间隔
WORKER_POLL_INTERVAL=5s
# 实时网关监听地址
REALTIME_ADDRESS=:8081
# WebSocket 允许的浏览器来源，逗号分隔；生产环境必须替换为实际前端域名
REALTIME_ALLOWED_ORIGINS=localhost:*,127.0.0.1:*
# PostgreSQL 连接串
POSTGRES_DSN=postgres://blockbeast:blockbeast@postgres:5432/blockbeast?sslmode=disable
# Redis 地址（当前功能按需使用）
REDIS_ADDRESS=redis:6379
# NATS JetStream 地址
NATS_URL=nats://nats:4222
# JWT 签名密钥。生产环境必须替换为随机高强度字符串，不能提交到 Git。
AUTH_TOKEN_SECRET=dev-only-signing-secret-change-me-in-production-0123456789abcdef
# 开发阶段暂时关闭注册密码至少 12 位限制；APP_ENV=production 时无论此值为何都会强制启用
AUTH_STRICT_PASSWORD_POLICY=false
# JWT 访问令牌有效期
ACCESS_TOKEN_TTL=15m
# 刷新令牌有效期；刷新时旧令牌立即失效并轮换为新令牌
REFRESH_TOKEN_TTL=720h
# QuickNode TRON JSON-RPC 地址；必须从密钥管理或环境变量注入
QUICKNODE_TRON_URL=https://your-endpoint.tron-mainnet.quiknode.pro/your-token/jsonrpc
# OKX REST 行情基础地址
OKX_REST_URL=https://www.okx.com
# OKX K 线业务 WebSocket；实时订阅 candle1m，REST 仅用于断线或首次订阅补偿
OKX_WEBSOCKET_URL=wss://ws.okx.com:8443/ws/v5/business
# Webhook 时间戳允许偏差，防止重放攻击；回调验签使用 PQPA_API_SECRET
CHAIN_WEBHOOK_ALLOWED_SKEW=5m
# PQPA API 基础地址（请以 PQPA 商户后台或官方文档提供的地址为准）
PQPA_API_URL=https://api.pqpa.com
# PQPA 商户 API Key；不要写入代码或提交到 Git
PQPA_API_KEY=replace-with-sandbox-key
# PQPA 商户 API Secret；不要写入代码或提交到 Git
PQPA_API_SECRET=replace-with-sandbox-secret
# PQPA 支持资产缓存刷新间隔；链、币种、精度及充提能力由 Worker 自动同步，无需手工配置
PQPA_ASSET_SYNC_INTERVAL=1h
# USDT 提现风控，金额均为最小单位（6 位精度：1000000 = 1 USDT）
# 单笔最小 1 USDT
WITHDRAWAL_MIN_MINOR=1000000
# 单笔最大 10000 USDT
WITHDRAWAL_MAX_MINOR=10000000000
# 每个用户 UTC 自然日累计最大 50000 USDT；失败或拒绝的申请不计入
WITHDRAWAL_DAILY_LIMIT_MINOR=50000000000
