# 服务器：156.234.80.122
# 宝塔 Nginx 建议安装位置：
# /www/server/panel/vhost/nginx/block-beast.conf
#
# 依赖的公共代理参数安装到：
# /www/server/nginx/conf/snippets/block-beast-proxy.conf
#
# 当前没有配置业务域名和 TLS 证书，因此只监听 HTTP 80。
# 获得正式域名后应新增 HTTPS server，并将 HTTP 重定向至 HTTPS。

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

limit_req_zone $binary_remote_addr zone=block_beast_api:10m rate=100r/s;
limit_req_zone $binary_remote_addr zone=block_beast_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=block_beast_webhook:10m rate=30r/s;
limit_conn_zone $binary_remote_addr zone=block_beast_ws:10m;
limit_req_status 429;
limit_conn_status 429;

upstream block_beast_api {
    server 127.0.0.1:8080;
    keepalive 32;
}

upstream block_beast_realtime {
    server 127.0.0.1:8081;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name 156.234.80.122;

    server_tokens off;
    client_max_body_size 12m;
    client_body_timeout 15s;
    keepalive_timeout 65s;

    access_log /www/wwwlogs/block-beast.access.log;
    error_log /www/wwwlogs/block-beast.error.log warn;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), geolocation=(), microphone=()" always;

    # API 存活与就绪检查。
    location = /healthz {
        include /www/server/nginx/conf/snippets/block-beast-proxy.conf;
        proxy_pass http://block_beast_api;
    }

    location = /readyz {
        include /www/server/nginx/conf/snippets/block-beast-proxy.conf;
        proxy_pass http://block_beast_api;
    }

    # Realtime 健康检查使用独立路径，避免与 API /healthz 冲突。
    location = /realtime/healthz {
        include /www/server/nginx/conf/snippets/block-beast-proxy.conf;
        proxy_pass http://block_beast_realtime/healthz;
    }

    # WebSocket 必须在普通 /v1/ API 规则之前精确匹配。
    location = /v1/ws {
        limit_conn block_beast_ws 5;

        proxy_pass http://block_beast_realtime;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_send_timeout 75s;
        proxy_read_timeout 75s;
        proxy_buffering off;
        proxy_request_buffering off;
    }

    # 登录接口使用更严格的每 IP 限流。
    location = /v1/auth/login {
        limit_req zone=block_beast_auth burst=5 nodelay;
        include /www/server/nginx/conf/snippets/block-beast-proxy.conf;
        proxy_pass http://block_beast_api;
    }

    location = /v1/admin/auth/login {
        limit_req zone=block_beast_auth burst=5 nodelay;
        include /www/server/nginx/conf/snippets/block-beast-proxy.conf;
        proxy_pass http://block_beast_api;
    }

    # 链上充值回调。
    location = /v1/webhooks/chain/deposits {
        limit_req zone=block_beast_webhook burst=60 nodelay;
        include /www/server/nginx/conf/snippets/block-beast-proxy.conf;
        proxy_pass http://block_beast_api;
    }

    # 其余业务 API。
    location ^~ /v1/ {
        limit_req zone=block_beast_api burst=200 nodelay;
        include /www/server/nginx/conf/snippets/block-beast-proxy.conf;
        proxy_pass http://block_beast_api;
    }

    location / {
        return 404;
    }
}
