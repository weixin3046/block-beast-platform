# Docker Compose 镜像标签；建议使用 Git 提交号或发布版本，不使用浮动标签
APP_IMAGE_TAG=latest
# 中国大陆服务器可使用 https://goproxy.cn,direct 加速首次镜像构建
BUILD_GOPROXY=https://proxy.golang.org,direct
APP_ENV=production

# PostgreSQL 仅在 Compose 内网开放。密码同时用于初始化和应用连接；
# 如果包含 @、:、/ 等 URL 特殊字符，POSTGRES_DSN 中必须进行百分号编码。
POSTGRES_DB=blockbeast
POSTGRES_USER=blockbeast
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DSN=postgres://blockbeast:replace-with-a-strong-database-password@postgres:5432/blockbeast?sslmode=disable

# NATS 仅在 Compose 内网开放
NATS_USER=blockbeast
NATS_PASSWORD=replace-with-a-strong-nats-password
NATS_URL=nats://blockbeast:replace-with-a-strong-nats-password@nats:4222

API_ADDRESS=:8080
API_ALLOWED_ORIGINS=https://player.example.com,https://admin.example.com
REALTIME_ADDRESS=:8081
REALTIME_ALLOWED_ORIGINS=player.example.com,admin.example.com
WORKER_POLL_INTERVAL=1s

# 必须使用密码管理器生成的随机值；至少 32 字节 生成命令openssl rand -hex 24
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-bytes
# 密码严格规范只由此开关控制，不受 APP_ENV 影响
AUTH_STRICT_PASSWORD_POLICY=false
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW=15m
LOGIN_LOCKOUT_DURATION=15m
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# TRON 官方 TronGrid API Key；请从 TronGrid 控制台创建
TRON_GRID_API_KEY=
# TRON 官方 FullNode gRPC；为空会自动使用 HTTP 回退。
TRON_GRID_GRPC_ENDPOINT=grpc.trongrid.io:50051
OKX_REST_URL=https://www.okx.com
OKX_WEBSOCKET_URL=wss://ws.okx.com:8443/ws/v5/business
CHAIN_WEBHOOK_ALLOWED_SKEW=5m
PQPA_API_URL=https://api.pqpa.com
PQPA_API_KEY=replace-with-production-key
PQPA_API_SECRET=replace-with-production-secret
PQPA_ASSET_SYNC_INTERVAL=1h

WITHDRAWAL_MIN_MINOR=1000000
WITHDRAWAL_MAX_MINOR=10000000000
WITHDRAWAL_DAILY_LIMIT_MINOR=50000000000

# 当前生产环境使用 Docker 持久卷保存本地文件；未来可切换为 s3
UPLOAD_STORAGE_DRIVER=local
LOCAL_UPLOAD_ROOT=/data/uploads
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
UPLOAD_MAX_BYTES=10485760
UPLOAD_URL_TTL=10m

LEADERBOARD_REFRESH_INTERVAL=1m
RED_PACKET_TTL=24h
